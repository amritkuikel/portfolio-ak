import { eq } from "drizzle-orm";
import { afterAll, beforeAll, beforeEach, describe, expect, it } from "vitest";
import { __UPPER___SEARCH_DEFAULTS } from "@/features/__name__/schema";
import { isStaleError } from "@/lib/concurrency";
import { isAppError } from "@/lib/errors";
import { list__Pascal__ } from "@/server/__name__/repository";
import {
	create__Pascal__Item,
	delete__Pascal__Items,
	get__Pascal__OrThrow,
	update__Pascal__Item,
} from "@/server/__name__/service";
import * as schema from "@/server/db/schema";
import { createTestDb } from "../utils/test-db";

/**
 * __Title__ (generated by `pnpm new:feature`) against PGlite: create, list with
 * search and sort, edit with the version check, and delete with its audit row.
 */
let env: Awaited<ReturnType<typeof createTestDb>>;
const db = () => env.db;
const ADMIN = { id: "admin-1" };

beforeAll(async () => {
	env = await createTestDb(ADMIN.id);
}, 60_000);
afterAll(() => env.close());
beforeEach(async () => {
	await db().delete(schema.__camel__);
	await db().delete(schema.auditEvent);
});

const create = (title: string, notes = "") => create__Pascal__Item(db(), { title, notes }, ADMIN.id);
const list = (q = "") => list__Pascal__(db(), { ...__UPPER___SEARCH_DEFAULTS, q, pageSize: 20 });

describe("__Title__", () => {
	it("creates rows and lists them, newest change first, searchable by title and notes", async () => {
		await create("Alpha", "first");
		await create("Beta", "second");
		expect((await list()).items.map((row) => row.title)).toEqual(["Beta", "Alpha"]);
		expect((await list("seco")).items.map((row) => row.title)).toEqual(["Beta"]);
		expect((await list()).total).toBe(2);
	});

	it("saves an edit made from the current version and refuses a stale one", async () => {
		const row = await create("Alpha");
		const saved = await update__Pascal__Item(db(), { id: row.id, updatedAt: row.updatedAt, title: "Alpha 2", notes: "" });
		expect(saved.title).toBe("Alpha 2");
		const stale = await update__Pascal__Item(db(), { id: row.id, updatedAt: row.updatedAt, title: "Lost", notes: "" }).catch(
			(error: unknown) => error,
		);
		expect(isStaleError(stale)).toBe(true);
		expect((await get__Pascal__OrThrow(db(), row.id)).title).toBe("Alpha 2");
	});

	it("deletes rows with one audit row each, and a missing row is NOT_FOUND", async () => {
		const row = await create("Alpha");
		expect(await delete__Pascal__Items(db(), [row.id], ADMIN)).toEqual({ deleted: 1 });
		const audit = await db().select().from(schema.auditEvent).where(eq(schema.auditEvent.targetId, row.id));
		expect(audit).toMatchObject([{ action: "__name__.delete", targetType: "__name__", targetLabel: "Alpha" }]);
		const missing = await get__Pascal__OrThrow(db(), row.id).catch((error: unknown) => error);
		expect(isAppError(missing) && missing.code).toBe("NOT_FOUND");
	});
});
