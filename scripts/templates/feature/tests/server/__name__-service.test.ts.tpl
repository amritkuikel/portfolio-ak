import { asc, eq } from "drizzle-orm";
import { afterAll, beforeAll, beforeEach, describe, expect, it } from "vitest";
import type { __Pascal__Input } from "@/features/__name__/schema";
import { __camel__List } from "@/features/__name__/search";
import type { Actor } from "@/features/rbac/types";
import { isStaleError } from "@/lib/concurrency";
import { isAppError } from "@/lib/errors";
import * as __camel__ from "@/server/__name__/service";
import * as schema from "@/server/db/schema";
import { createTestDb } from "../utils/test-db";

/**
 * __Title__ (generated by `pnpm new:feature`) against PGlite: create, list with
 * search and sort, edit with the version check, delete, and an audit row for each change.
 */
let env: Awaited<ReturnType<typeof createTestDb>>;
const ADMIN: Actor = { id: "admin-1", isAdmin: true, permissions: [] };
const services = () => ({ db: env.db, actor: ADMIN, imageStore: null });

beforeAll(async () => {
	env = await createTestDb(ADMIN.id);
}, 60_000);
afterAll(() => env.close());
beforeEach(() => env.reset());

{{#localized}}
const input = (title: string, notes = "", extra: Partial<__Pascal__Input> = {}): __Pascal__Input => ({
	title: { en: title, ne: "" },
	notes: { en: notes, ne: "" },
{{#public}}
	slug: title.toLowerCase().replaceAll(" ", "-"),
	published: false,
{{/public}}
	...extra,
});
const titleOf = (row: { title: { en: string } }) => row.title.en;
{{/localized}}
{{^localized}}
const input = (title: string, notes = "", extra: Partial<__Pascal__Input> = {}): __Pascal__Input => ({
	title,
	notes,
{{#public}}
	slug: title.toLowerCase().replaceAll(" ", "-"),
	published: false,
{{/public}}
	...extra,
});
const titleOf = (row: { title: string }) => row.title;
{{/localized}}
const create = (title: string, notes = "", extra: Partial<__Pascal__Input> = {}) =>
	__camel__.create(services(), input(title, notes, extra));
const list = (q = "") => __camel__.list(services(), { ...__camel__List.defaults, q, pageSize: 20 });
const auditOf = (id: string) =>
	env.db
		.select()
		.from(schema.auditEvent)
		.where(eq(schema.auditEvent.targetId, id))
		.orderBy(asc(schema.auditEvent.createdAt));

describe("__Title__", () => {
	it("creates rows and lists them, newest change first, searchable by title and notes", async () => {
		await create("Alpha", "first");
		await create("Beta", "second");
		expect((await list()).items.map(titleOf)).toEqual(["Beta", "Alpha"]);
		expect((await list("seco")).items.map(titleOf)).toEqual(["Beta"]);
		expect((await list()).total).toBe(2);
	});

	it("saves an edit made from the current version, refuses a stale one, and audits each change", async () => {
		const row = await create("Alpha");
		const saved = await __camel__.update(services(), { ...input("Alpha 2"), id: row.id, updatedAt: row.updatedAt });
		expect(titleOf(saved)).toBe("Alpha 2");
		const stale = await __camel__
			.update(services(), { ...input("Lost"), id: row.id, updatedAt: row.updatedAt })
			.catch((error: unknown) => error);
		expect(isStaleError(stale)).toBe(true);
		expect(titleOf(await __camel__.get(services(), row.id))).toBe("Alpha 2");
		expect((await auditOf(row.id)).map((entry) => entry.action)).toEqual(["__name__.create", "__name__.update"]);
	});

	it("deletes rows with one audit row each, and a missing row is NOT_FOUND", async () => {
		const row = await create("Alpha");
		expect(await __camel__.remove(services(), [row.id])).toEqual({ deleted: 1 });
		expect((await auditOf(row.id)).at(-1)).toMatchObject({ action: "__name__.delete", targetType: "__name__" });
		const missing = await __camel__.get(services(), row.id).catch((error: unknown) => error);
		expect(isAppError(missing) && missing.code).toBe("NOT_FOUND");
	});
{{#public}}

	it("a taken slug is a CONFLICT on the slug field", async () => {
		await create("Alpha");
		const taken = await create("Other", "", { slug: "alpha" }).catch((error: unknown) => error);
		expect(isAppError(taken) && taken.fieldErrors?.slug).toBeTruthy();
		expect(await __camel__.isSlugFree(services(), { slug: "alpha" })).toBe(false);
	});

	it("public reads see only published rows", async () => {
		await create("Draft");
		await create("Shown", "", { published: true });
		expect((await __camel__.listPublished(services(), { q: "", page: 1 }, 10)).items.map(titleOf)).toEqual(["Shown"]);
		const draft = await __camel__.getPublished(services(), "draft").catch((error: unknown) => error);
		expect(isAppError(draft) && draft.code).toBe("NOT_FOUND");
		expect((await __camel__.sitemapEntries(services())).map((entry) => entry.path)).toEqual([
			"/__name__",
			"/__name__/shown",
		]);
	});
{{/public}}
});
