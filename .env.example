# -----------------------------------------------------------------------------
# Environment variables
#
# Copy this file to `.env` and fill in the values:  cp .env.example .env
# `.env` is gitignored. Never commit real secrets.
#
# Validation: src/server/env.ts (server) and src/lib/client-env.schema.ts (client).
# `pnpm dev` and `pnpm start` refuse to boot if a required variable is missing
# or invalid, and the error names each offending variable.
# -----------------------------------------------------------------------------

# =============================================================================
# Client (public)
# Only variables prefixed with VITE_ reach the browser. They are inlined into
# the bundle at BUILD time, so changing one requires a rebuild.
# Never put a secret in a VITE_ variable.
# =============================================================================

# Site name. Shown in the header and used as the page <title>. 1-60 characters.
VITE_APP_TITLE="Portfolio"

# Public origin of the site (no path, no trailing slash). Used for canonical,
# hreflang and Open Graph URLs. Set it to the production domain when deploying.
VITE_SITE_URL="http://localhost:3000"

# =============================================================================
# Server (secret)
# Read at runtime on the server only. Validated when the server boots.
# =============================================================================

# Neon Postgres connection strings (Neon console > Connect).
# Must use the postgres:// or postgresql:// scheme. `sslmode=require` is upgraded to
# `verify-full` automatically (same security, no pg warning); see decision 0017.
#
# DATABASE_URL: the POOLED string (host contains "-pooler"). Used by the app at runtime.
DATABASE_URL="postgresql://user:password@ep-example-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# DATABASE_URL_UNPOOLED: the DIRECT string (no "-pooler"). Used by drizzle-kit for
# migrations. Optional; falls back to DATABASE_URL. Vercel's Neon integration sets it.
DATABASE_URL_UNPOOLED=""

# Email delivery provider: "console" (prints emails to the terminal) or "resend".
# Optional. When unset: Resend if RESEND_API_KEY is set, otherwise console in development.
# A production build refuses to start with "console" or with no Resend key,
# because emails would silently never be delivered.
EMAIL_PROVIDER="console"

# Resend API key (https://resend.com/api-keys). Starts with "re_".
# Optional, but required when EMAIL_PROVIDER="resend".
RESEND_API_KEY=""

# Better Auth secret: signs sessions, cookies and email tokens. 32+ random characters.
# Generate one with:  openssl rand -base64 32
# Rotating it signs every user out and invalidates pending email links.
BETTER_AUTH_SECRET=""

# Public origin of the app (no trailing slash). Used for links in emails and
# OAuth callbacks, and as the trusted origin for auth requests.
# Development: http://localhost:3000   Production: https://your-domain.com
BETTER_AUTH_URL="http://localhost:3000"

# Optional Google sign-in (https://console.cloud.google.com/apis/credentials).
# Set both or neither. The "Continue with Google" button only appears when both are set.
# Authorised redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional defaults for `pnpm db:seed-admin` (command-line flags override these).
# The password must be at least 12 characters.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME=""

# Sender address for outgoing email. Either a bare address or "Name <address>".
# With Resend, the domain must be verified in your Resend account.
EMAIL_FROM="Portfolio <hello@example.com>"
