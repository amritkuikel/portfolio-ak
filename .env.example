# -----------------------------------------------------------------------------
# Environment variables
#
# Copy this file to `.env` and fill in the values:  cp .env.example .env
# `.env` is gitignored. Never commit real secrets.
#
# Validation: src/server/env.ts (server) and src/lib/client-env.schema.ts (client).
# `pnpm dev` and `pnpm start` refuse to boot if a required variable is missing
# or invalid, and the error names each offending variable.
# -----------------------------------------------------------------------------

# =============================================================================
# Client (public)
# Only variables prefixed with VITE_ reach the browser. They are inlined into
# the bundle at BUILD time, so changing one requires a rebuild.
# Never put a secret in a VITE_ variable.
# =============================================================================

# Site name. Shown in the header and used as the page <title>. 1-60 characters.
VITE_APP_TITLE="Portfolio"

# =============================================================================
# Server (secret)
# Read at runtime on the server only. Validated when the server boots.
# =============================================================================

# Neon Postgres connection string (Neon console > Connection details).
# Must use the postgres:// or postgresql:// scheme.
# Example: postgresql://user:password@ep-cool-name-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Email delivery provider: "console" (prints emails to the terminal, for development)
# or "resend" (sends real email). Optional; selection rules arrive in Phase 6.
EMAIL_PROVIDER="console"

# Resend API key (https://resend.com/api-keys). Starts with "re_".
# Optional, but required when EMAIL_PROVIDER="resend".
RESEND_API_KEY=""

# Sender address for outgoing email. Either a bare address or "Name <address>".
# With Resend, the domain must be verified in your Resend account.
EMAIL_FROM="Portfolio <hello@example.com>"
