# -----------------------------------------------------------------------------
# Environment variables
#
# Copy this file to `.env` and fill in the values:  cp .env.example .env
# `.env` is gitignored. Never commit real secrets.
#
# Validation: src/server/env.ts (server) and src/lib/client-env.schema.ts (client).
# `pnpm dev` and `pnpm start` refuse to boot if a required variable is missing
# or invalid, and the error names each offending variable.
# -----------------------------------------------------------------------------

# =============================================================================
# Client (public)
# Only variables prefixed with VITE_ reach the browser. They are inlined into
# the bundle at BUILD time, so changing one requires a rebuild.
# Never put a secret in a VITE_ variable.
# =============================================================================

# Site name. Shown in the header and used as the page <title>. 1-60 characters.
VITE_APP_TITLE="Portfolio"

# Public origin of the site (no path, no trailing slash). Used for canonical,
# hreflang and Open Graph URLs. Set it to the production domain when deploying.
VITE_SITE_URL="http://localhost:3000"

# --- Observability (optional). Leave unset to turn a service off completely. ---
# Sentry DSN (Project settings > Client Keys). Enables error and performance monitoring
# in the browser and on the server.
# VITE_SENTRY_DSN="https://<key>@o<org>.ingest.sentry.io/<project>"
# Development only: send a trace for every request and navigation. Off by default
# because tracing everything slows `pnpm dev` down; production samples 10%.
# VITE_SENTRY_DEV_TRACING="true"
# PostHog project API key and ingest host. Nothing is sent before the visitor consents.
# VITE_POSTHOG_KEY="phc_..."
# VITE_POSTHOG_HOST="https://us.i.posthog.com"

# =============================================================================
# Server (secret)
# Read at runtime on the server only. Validated when the server boots.
# =============================================================================

# Neon Postgres connection strings (Neon console > Connect).
# Must use the postgres:// or postgresql:// scheme. `sslmode=require` is upgraded to
# `verify-full` automatically (same security, no pg warning); see decision 0017.
#
# DATABASE_URL: the POOLED string (host contains "-pooler"). Used by the app at runtime.
DATABASE_URL="postgresql://user:password@ep-example-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# DATABASE_URL_UNPOOLED: the DIRECT string (no "-pooler"). Used by drizzle-kit for
# migrations. Optional; falls back to DATABASE_URL. Vercel's Neon integration sets it.
DATABASE_URL_UNPOOLED=""

# Email delivery provider: "console" (prints emails to the terminal) or "resend".
# Optional. When unset: Resend if RESEND_API_KEY is set, otherwise console in development.
# A production build refuses to start with "console" or with no Resend key,
# because emails would silently never be delivered.
EMAIL_PROVIDER="console"

# Resend API key (https://resend.com/api-keys). Starts with "re_".
# Optional, but required when EMAIL_PROVIDER="resend".
RESEND_API_KEY=""

# Better Auth secret: signs sessions, cookies and email tokens. 32+ random characters.
# Generate one with:  openssl rand -base64 32
# Rotating it signs every user out and invalidates pending email links.
BETTER_AUTH_SECRET=""

# Public origin of the app (no trailing slash). Used for links in emails and
# OAuth callbacks, and as the trusted origin for auth requests.
# Development: http://localhost:3000   Production: https://your-domain.com
BETTER_AUTH_URL="http://localhost:3000"

# Optional Google sign-in (https://console.cloud.google.com/apis/credentials).
# Set both or neither. The "Continue with Google" button only appears when both are set.
# Authorised redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Require two-factor authentication for everyone with an admin permission before they
# can use /admin ("true" or "false", default "false"). See docs/decisions.md 0126.
# AUTH_REQUIRE_ADMIN_2FA="false"

# Refuse passwords that appear in Have I Been Pwned's breach corpus on sign-up, reset
# and change ("true" or "false", default "true"). Only the first 5 characters of the
# password's SHA-1 hash are sent. See 0127.
# AUTH_BREACHED_PASSWORD_CHECK="true"

# Optional Cloudflare Turnstile (https://dash.cloudflare.com/?to=/:account/turnstile) on
# register, forgot-password and sign-in-code. Set both or neither; unset, no captcha.
# Testing keys that always pass: 1x00000000000000000000AA / 1x0000000000000000000000000000000AA
# TURNSTILE_SITE_KEY=""
# TURNSTILE_SECRET_KEY=""

# Optional defaults for `pnpm db:seed-admin` (command-line flags override these).
# The password must be at least 12 characters.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME=""

# Optional default password for `pnpm db:seed-demo` (development data). At least 12 characters.
DEMO_PASSWORD=""

# Sender address for outgoing email. Either a bare address or "Name <address>".
# With Resend, the domain must be verified in your Resend account.
EMAIL_FROM="Portfolio <hello@example.com>"

# Optional: evaluate PostHog feature flags on this server (definitions polled every 30 s)
# instead of asking PostHog on each page render. A Project Secret API Key (phs_...) or a
# Personal API Key (phx_...). Unset: flags are fetched with a 300 ms timeout, cached 30 s.
# POSTHOG_SECRET_KEY=""

# =============================================================================
# Sentry source map upload (build time only, optional; set all three or none)
# =============================================================================
# Create an auth token with the project:releases scope. Keep it secret: never VITE_.
# SENTRY_AUTH_TOKEN=""
# SENTRY_ORG=""
# SENTRY_PROJECT=""

# =============================================================================
# Cloudinary: image attachments (optional; set the first three or none)
# =============================================================================
# From the Cloudinary console (Settings > API Keys). The secret signs uploads on
# the server and must never be exposed: never VITE_. Without these, uploads are
# disabled and items show placeholders.
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
# Public-id prefix for this app's uploads (default "portfolio").
# CLOUDINARY_FOLDER="portfolio"

# =============================================================================
# Scheduled jobs (optional)
# =============================================================================
# Bearer token Vercel Cron sends to /api/cron/* (16+ random characters,
# e.g. openssl rand -hex 24). Unset: the cron routes answer 404.
# CRON_SECRET=""
