utTh0BVGV.png","provider_id":3,"provider_name":"Google Play Movies","display_priority":23},{"logo_path":"/wpOt6x0dRxTrIzuBosto4LGd7E9.png","provider_id":7,"provider_name":"Fandango At Home","display_priority":40}]}}},"alternative_titles":{"results":[{"iso_3166_1":"CN","title":"星际旅行：原初","type":""},{"iso_3166_1":"CZ","title":"Star Trek: Originální série","type":""},{"iso_3166_1":"DE","title":"Star Trek - Raumschiff Enterprise","type":""},{"iso_3166_1":"ES","title":"Star Trek: La serie original","type":""},{"iso_3166_1":"ES","title":"Star Trek: La sèrie original","type":"Catalan"},{"iso_3166_1":"GR","title":"Ταξίδι Στ' αστέρια","type":""},{"iso_3166_1":"IT","title":"Star Trek - La serie classica","type":""},{"iso_3166_1":"JP","title":"宇宙大作戦／スタートレック","type":""}]},"reviews":{"page":1,"results":[{"author":"Mark Butler","author_details":{"name":"Mark Butler","username":"StoneMonkeyMark","avatar_path":null,"rating":7},"content":"The original series may be a bit hard to watch with a modern mind set, but the episodes still contain the key discussions on what it is to be human. Really the show was a great platform for modern thinking and is worth watching to understand the process that people went through to get to the modern day. Yes it is Science Fiction, but really it is Social Commentary.","created_at":"2019-02-25T18:16:50Z","id":"5c743112c3a3685a3e1a0bab","updated_at":"2021-06-23T15:58:17Z","url":"https://www.themoviedb.org/review/5c743112c3a3685a3e1a0bab"},{"author":"Peter89Spencer","author_details":{"name":"","username":"Peter89Spencer","avatar_path":null,"rating":8},"content":"Before Star Wars, this was a fan favorite for sci fi fans alike!\r\n\r\nIt was campy, cheesy, entertaining, and a little bit pervy!\r\nI mean, C'mon, there were scandidly clad women in the show, even for the 60s! And don't get me started on the Starfleet women's short skirts!\r\nProbably my best highlight of the show! 😅\r\n\r\nBut yeah, the original series was the best.","created_at":"2021-08-18T12:59:25Z","id":"611d042d87f3f2004550147c","updated_at":"2021-08-18T12:59:25Z","url":"https://www.themoviedb.org/review/611d042d87f3f2004550147c"},{"author":"goththug","author_details":{"name":"","username":"goththug","avatar_path":null,"rating":null},"content":"Star Trek (AKA Star Trek The Original Series, AKA STTOS) is a series that has had a dramatic influence across much of the science fiction genre, and as some have suggested, influenced culture around the world. The writing, directing, and cinematography of Star Trek are top-notch, even by today's standards. On par with more recent series like Battlestar 2004. \r\n\r\nFrom the top writers and directors of science fiction of that era, sophisticated storylines across the series deal with challenging topics that are risqué even today. Star Trek was radically ahead of its time in the 60’s having a multi-racial main cast including things like non-white character’s and women holding officer positions in Starfleet (unheard of at that time and for decades after)\r\n\r\nWarning: Some female characters wear mini-skirts (a fade in the 60’s). Some creatures had campy costumes (state of the art in the 60’s). I would recommend checking out “The Original Series Remastered Project” which has the series remastered at 1080p with updated CGI graphics.","created_at":"2021-11-01T23:57:26Z","id":"61807ee6a097dc0065034301","updated_at":"2021-12-03T21:49:35Z","url":"https://www.themoviedb.org/review/61807ee6a097dc0065034301"}],"total_pages":1,"total_results":5}}
