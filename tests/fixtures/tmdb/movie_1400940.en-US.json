_1":"US","release_dates":[{"certification":"","descriptors":[],"iso_639_1":"","note":"Los Angeles, California","release_date":"2026-10-13T00:00:00.000Z","type":1},{"certification":"R","descriptors":[],"iso_639_1":"","note":"","release_date":"2026-10-23T00:00:00.000Z","type":3},{"certification":"","descriptors":[],"iso_639_1":"","note":"","release_date":"2026-12-07T00:00:00.000Z","type":4}]}]},"keywords":{"keywords":[{"id":1299,"name":"monster"},{"id":1370,"name":"shapeshifting"},{"id":9717,"name":"based on comic"},{"id":9748,"name":"revenge"},{"id":10614,"name":"tragedy"},{"id":11578,"name":"mobster"},{"id":10048,"name":"unrequited love"},{"id":157676,"name":"disfigured face"},{"id":183133,"name":"aspiring actor"},{"id":228384,"name":"female scientist"},{"id":240435,"name":"scientific experiment"},{"id":283085,"name":"body horror"}]},"external_ids":{"imdb_id":"tt34890576","wikidata_id":"Q131460936","facebook_id":"ClayfaceMovie","instagram_id":"clayfacemovie","twitter_id":"ClayfaceMovieDC"},"watch/providers":{"results":{"US":{"link":"https://www.themoviedb.org/movie/1400940-clayface/watch?locale=US","buy":[{"logo_path":"/wpOt6x0dRxTrIzuBosto4LGd7E9.png","provider_id":7,"provider_name":"Fandango At Home","display_priority":41}]}}},"alternative_titles":{"titles":[{"iso_3166_1":"LT","title":"Moliaveidis","type":""},{"iso_3166_1":"BR","title":"Cara de Barro","type":""},{"iso_3166_1":"RU","title":"Глиноликий","type":""},{"iso_3166_1":"TH","title":"เคลย์เฟซ","type":"Thai"}]},"reviews":{"page":1,"results":[{"author":"Abliss_","author_details":{"name":"","username":"Abliss_","avatar_path":"/qeLOU3B6PGnTmfBielIBgr2FBNy.png","rating":7},"content":"I originally thought this was a straight horror film, so I was surprised to find out it was more of a drama, but I LOVED the visual effects!","created_at":"2026-10-23T02:32:32Z","id":"6adac740762c9c36c8b0d9fa","updated_at":"2026-10-23T02:32:32Z","url":"https://www.themoviedb.org/review/6adac740762c9c36c8b0d9fa"},{"author":"Manuel São Bento","author_details":{"name":"Manuel São Bento","username":"msbreviews","avatar_path":null,"rating":7},"content":"Check out my full review @ https://movieswetextedabout.com/clayface-movie-review-tom-rhys-harries-leads-a-gruesome-satisfying-dcu-villain-story/\r\n\r\nRating: B\r\n\r\nCLAYFACE is a grotesque, committed body horror villain origin story that’s refreshingly standalone. Tom Rhys Harries gives a pretty great lead performance, subtle for most of it and menacing when it counts. Naomi Ackie is good alongside him. The practical effects and prosthetics are remarkable, the disco set piece is a blast, and the airplane bathroom scene had me looking away. I liked that it lets Matt be a villain and ties his career so bluntly to his face. Away from him, though, the writing gets thin. The supporting characters and the mobsters are weak, the second act runs in circles, the editing cuts corners on the transformations, and Gotham looks like any other city. Still, I quite liked it. My DCU streak lives on!","created_at":"2026-10-23T21:05:19Z","id":"6adbcc0f30905141b350fdab","updated_at":"2026-10-23T21:05:19Z","url":"https://www.themoviedb.org/review/6adbcc0f30905141b350fdab"},{"author":"RyanReaXts","author_details":{"name":"","username":"RyanReaXts","avatar_path":null,"rating":10},"content":"The Dark Knight has many tragic villains, and Clayface is one I can't help but feel bad for.\r\n\r\nThis movie is horrifying, heartbreaking and completely original.\r\n\r\nTom Rhys-Harries brings the character to life with a tragic and memorable performance. The body horror effects were grotesque and made my skin crawl.\r\n\r\nThis movie has opened the door for a new era of DC films and I'm excited if a few of them end up being horror.","created_at":"2026-10-24T21:05:47Z","id":"6add1dab40f2d18dff170e8b","updated_at":"2026-10-25T02:59:21Z","url":"https://www.themoviedb.org/review/6add1dab40f2d18dff170e8b"}],"total_pages":1,"total_results":8}}
