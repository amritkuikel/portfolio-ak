{
	"name": "portfolio",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev --port 3000",
		"build": "vite build",
		"start": "node --env-file-if-exists=.env .output/server/index.mjs",
		"preview": "vite preview",
		"typecheck": "pnpm i18n:compile && tsc --noEmit",
		"check": "biome check --error-on-warnings",
		"check:fix": "biome check --write",
		"test": "vitest run",
		"test:watch": "vitest",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"storybook": "node scripts/not-installed.mjs storybook \"Phase 11 (Storybook)\"",
		"build-storybook": "node scripts/not-installed.mjs build-storybook \"Phase 11 (Storybook)\"",
		"i18n:compile": "paraglide-js compile --project ./project.inlang --silent"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/noto-sans-devanagari": "^5.3.0",
		"@t3-oss/env-core": "^0.13.11",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-devtools": "^0.10.13",
		"@tanstack/react-query": "^5.104.0",
		"@tanstack/react-router": "^1.170.40",
		"@tanstack/react-router-devtools": "^1.167.2",
		"@tanstack/react-router-ssr-query": "^1.167.3",
		"@tanstack/react-start": "^1.168.59",
		"@vercel/functions": "^3.9.9",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cn": "^0.4.0",
		"drizzle-orm": "^0.45.3",
		"lucide-react": "^0.577.0",
		"nitro": "3.0.260610-beta",
		"pg": "^8.23.0",
		"radix-ui": "^1.6.7",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.7.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.5",
		"@inlang/paraglide-js": "^2.25.4",
		"@tailwindcss/typography": "^0.5.20",
		"@tanstack/devtools-vite": "^0.8.5",
		"@types/jsdom": "^30.0.0",
		"@types/node": "^22.20.4",
		"@types/pg": "^8.23.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"drizzle-kit": "^0.31.11",
		"jsdom": "^30.1.1",
		"typescript": "^6.0.3",
		"vite": "^8.3.1",
		"vitest": "^5.0.2"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"lightningcss"
		]
	},
	"packageManager": "pnpm@10.33.2",
	"engines": {
		"node": ">=22"
	}
}
