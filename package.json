{
	"name": "start-template",
	"private": true,
	"type": "module",
	"scripts": {
		"setup:local": "node scripts/setup-local.ts",
		"diagnose": "node scripts/diagnose.ts",
		"dev": "vite dev --port 3000",
		"dev:local": "node scripts/dev-local.ts",
		"dev:offline": "node scripts/dev-offline.ts",
		"build": "vite build",
		"start": "node --env-file-if-exists=.env .output/server/index.mjs",
		"preview": "vite preview",
		"typecheck": "pnpm i18n:compile && tsc --noEmit",
		"check": "biome check --error-on-warnings",
		"check:fix": "biome check --write",
		"knip": "knip",
		"test": "vitest run --project unit",
		"test:watch": "vitest --project unit",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:check": "drizzle-kit check",
		"db:studio": "drizzle-kit studio",
		"storybook": "storybook dev -p 6006 --no-open",
		"build-storybook": "storybook build",
		"i18n:compile": "paraglide-js compile --project ./project.inlang --silent",
		"i18n:translate": "inlang machine translate --project ./project.inlang --locale en --targetLocales ne",
		"i18n:check": "inlang check --project ./project.inlang --missing-translations --empty-translations --empty-variants --missing-variables --unknown-variables --missing-markup --missing-variants --missing-selectors",
		"db:seed-admin": "node scripts/seed-admin.ts",
		"db:seed-demo": "node scripts/seed-demo.ts",
		"db:seed-portfolio": "node scripts/seed-portfolio.ts",
		"auth:schema": "auth generate --config src/server/auth/auth.ts --output src/server/db/schema/auth.ts --yes && biome format --write src/server/db/schema/auth.ts",
		"test:storybook": "vitest run --project storybook --project storybook-dark-ne",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:coverage": "vitest run --project unit --coverage && node scripts/coverage-report.ts",
		"new:feature": "node scripts/new-feature.ts",
		"strip-demo": "node scripts/strip-demo.ts",
		"prepare": "node scripts/install-hooks.mjs"
	},
	"dependencies": {
		"@better-auth/drizzle-adapter": "^1.7.6",
		"@dnd-kit/dom": "0.5.1",
		"@dnd-kit/react": "0.5.1",
		"@fontsource-variable/anek-devanagari": "5.3.0",
		"@fontsource-variable/anek-latin": "5.3.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/noto-sans-devanagari": "^5.3.0",
		"@sentry/tanstackstart-react": "11.4.0",
		"@t3-oss/env-core": "^0.13.11",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/query-db-collection": "^1.3.5",
		"@tanstack/react-db": "^0.5.4",
		"@tanstack/react-devtools": "^0.10.13",
		"@tanstack/react-form": "^1.33.5",
		"@tanstack/react-form-devtools": "^0.2.34",
		"@tanstack/react-query": "^5.104.5",
		"@tanstack/react-query-devtools": "^5.104.5",
		"@tanstack/react-router": "^1.170.40",
		"@tanstack/react-router-devtools": "^1.167.2",
		"@tanstack/react-router-ssr-query": "^1.167.3",
		"@tanstack/react-router-with-db": "^0.1.0",
		"@tanstack/react-start": "^1.168.59",
		"@tanstack/react-store": "^0.11.2",
		"@tanstack/react-table": "^9.3.1",
		"@tiptap/pm": "^3.31.4",
		"@tiptap/react": "^3.31.4",
		"@tiptap/starter-kit": "^3.31.4",
		"@vercel/functions": "^3.9.9",
		"better-auth": "^1.7.6",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"drizzle-orm": "^0.45.4",
		"input-otp": "^1.5.0",
		"libphonenumber-js": "^1.13.14",
		"lucide-react": "^0.577.0",
		"nitro": "3.0.260610-beta",
		"pg": "^8.23.0",
		"posthog-js": "1.437.0",
		"posthog-node": "5.55.0",
		"radix-ui": "^1.6.7",
		"react": "^19.3.0",
		"react-day-picker": "^10.0.2",
		"react-dom": "^19.3.0",
		"react-email": "^6.11.0",
		"recharts": "^3.10.1",
		"resend": "^6.30.0",
		"sanitize-html": "^2.18.0",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.7.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"uqr": "^0.1.3",
		"web-vitals": "^6.2.3",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.14.0",
		"@babel/core": "^7.29.7",
		"@biomejs/biome": "2.4.5",
		"@electric-sql/pglite": "^0.5.8",
		"@inlang/cli": "3.4.4",
		"@inlang/paraglide-js": "^2.25.4",
		"@inlang/plugin-m-function-matcher": "2.3.4",
		"@inlang/plugin-message-format": "4.5.5",
		"@playwright/test": "1.64.0",
		"@rolldown/plugin-babel": "^0.2.4",
		"@storybook/addon-a11y": "10.6.1",
		"@storybook/addon-vitest": "10.6.1",
		"@storybook/react-vite": "10.6.1",
		"@tailwindcss/typography": "^0.5.20",
		"@tanstack/devtools-vite": "^0.8.5",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.7",
		"@types/babel__core": "^7.20.5",
		"@types/jsdom": "^30.0.0",
		"@types/node": "^22.20.4",
		"@types/pg": "^8.23.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/sanitize-html": "^2.16.2",
		"@vitejs/plugin-react": "^6.1.1",
		"@vitest/browser": "5.0.3",
		"@vitest/browser-playwright": "5.0.3",
		"@vitest/coverage-v8": "5.0.3",
		"auth": "^1.7.6",
		"babel-plugin-react-compiler": "1.0.0",
		"drizzle-kit": "^0.31.11",
		"jsdom": "^30.1.1",
		"knip": "^6.42.0",
		"lefthook": "^2.2.2",
		"playwright": "1.64.0",
		"schema-dts": "^2.1.0",
		"storybook": "10.6.1",
		"typescript": "^6.0.3",
		"vite": "^8.3.1",
		"vitest": "^5.0.3"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"lightningcss"
		],
		"ignoredBuiltDependencies": [
			"core-js",
			"lefthook"
		]
	},
	"packageManager": "pnpm@10.33.2",
	"engines": {
		"node": ">=22.18"
	}
}
